# ===== 服务 =====
NODE_ENV=production
PORT=8080
# 前端来源（CORS 白名单，逗号分隔）。
# 本服务同源托管 web/ 静态站（零构建），纯同源部署可留空；跨域访问时必须填前端来源，如：
# CORS_ORIGINS=https://ju.zhongnanyinghua.com,https://www.zhongnanyinghua.com
CORS_ORIGINS=
# 设为 1 可关闭自主进化定时任务（多实例部署也可只在一台保留）
DISABLE_AUTO_SCHEDULER=
# 设为 1 可关闭托管放款 setInterval（veFaaS 等 serverless 环境必设，改由云定时任务驱动）
DISABLE_CRON=

# ===== 数据库 =====
# PostgreSQL 16；本仓库无 prisma migrate 历史，部署用 npx prisma db push 对齐 schema
DATABASE_URL=postgresql://zhongnan:change_me@127.0.0.1:5432/zhongnan?schema=public

# ===== 鉴权 =====
# 生产强制：长度≥16，建议 openssl rand -hex 32 各生成一次；缺失则进程拒绝启动
JWT_ACCESS_SECRET=change_me_access_secret_min_16_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_16_chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ===== 配置项加密密钥（src/lib/crypto.ts，加密落库的供应商配置）=====
# openssl rand -hex 32；轮换后旧密文无法解密，请妥善保存
CONFIG_SECRET=

# ===== 模型供应商密钥（最高机密：仅服务端持有，绝不下发前端/不进 Git）=====
# 黑盒：用户只看到“经济/标准/旗舰引擎”，看不到供应商与模型名
# 统一网关（OpenAI 兼容协议，如火山方舟兼容端点；不配则默认 https://api.openai.com/v1）
MODEL_GATEWAY_BASE_URL=
# 各文本档密钥与模型名（t ∈ ECONOMY/STANDARD/FLAGSHIP，对应 MODEL_TEXT_<t>_KEY / MODEL_<t>）
MODEL_TEXT_ECONOMY_KEY=
MODEL_TEXT_STANDARD_KEY=
MODEL_TEXT_FLAGSHIP_KEY=
MODEL_ECONOMY=
MODEL_STANDARD=
MODEL_FLAGSHIP=
# 图片档：可单独指定图片网关，缺省回退 MODEL_GATEWAY_BASE_URL
MODEL_IMAGE_GATEWAY_BASE_URL=
MODEL_IMAGE_STANDARD_KEY=
MODEL_IMAGE_STANDARD=
MODEL_IMAGE_FLAGSHIP_KEY=
MODEL_IMAGE_FLAGSHIP=gpt-image-1
# 未配置图片密钥时海报接口返回 IMAGE_NOT_CONFIGURED，业务侧自动退款，不影响主链路

# ===== 支付回调验签（fail-closed；未配置则一律拒绝回调，绝不发货）=====
# 当前为内置占位验签，生产上线前必须在 src/routes/order.ts 替换为官方 SDK：
#   微信 wechatpay-node-v3（平台证书 RSA-SHA256）/ 支付宝 alipay-sdk（RSA2）
WECHAT_API_V3_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_SECRET=

# ===== 以下为预留变量（当前代码尚未读取，接入相应能力时启用，勿误认为已生效）=====
# REDIS_URL=redis://127.0.0.1:6379/0
# WECHAT_APPID= / WECHAT_MCHID= / WECHAT_SERIAL_NO= / WECHAT_PRIVATE_KEY_PATH=./certs/wechat_apiclient_key.pem
# ALIPAY_APPID= / ALIPAY_PRIVATE_KEY_PATH=./certs/alipay_app_private_key.pem
# PAY_NOTIFY_URL=https://api.your-domain.com/api/order/notify
# 火山引擎 TOS 对象存储（海报等图片转存为永久 URL；不配则沿用模型返回的临时地址）
# TOS_REGION=cn-beijing / TOS_BUCKET=zhongnan-assets / TOS_ACCESS_KEY_ID= / TOS_ACCESS_KEY_SECRET=
# ADMIN_ACCOUNT= / ADMIN_INIT_PASSWORD=
